+
+// ============================================================================
+// C253 — ENTREGA DIFERIDA de recordatorios de en vivos programados.
+// *** PENDIENTE DE DEPLOY *** — ver docs/C253-LAMBDA-DEPLOY-CHECKLIST.md.
+// La función desplegada solo reacciona a INSERTs del stream y no tiene entrega
+// diferida: sin este handler (invocado por EventBridge Scheduler cada 5 min)
+// un recordatorio con la app 100% cerrada jamás se dispara. Este handler
+// escanea los tickets liveReminders/<liveId>, reclama atómicamente los
+// vencidos y escribe los ítems notifications/<uid>/<notifId>; el handler del
+// stream (ya desplegado) los convierte en push reales. Respeta el opt-out
+// 'fiestas' y traduce el mensaje al idioma del destinatario
+// (userSettings/<uid>/appLanguage).
+// ============================================================================
+
+const SCHED_EXPIRE_MS = 60 * 60 * 1000; // igual que EXPIRE_MS del cliente
+
+// I18N mínima embebida (la Lambda no lee drex-i18n.js).
+const SCHED_I18N = {
+  en: '{n} goes live in a few minutes',
+  zh: '{n} 将在几分钟后开始直播',
+  pt: '{n} entra ao vivo em alguns minutos',
+  es: '{n} empieza en vivo en unos minutos',
+};
+function schedMsg(hostName, title, lang) {
+  const tpl = SCHED_I18N[lang] || SCHED_I18N.en;
+  const m = String(tpl).replace('{n}', hostName || 'Drex');
+  return title ? m + ': ' + String(title).slice(0, 60) : m;
+}
+
+// Reensambla tickets desde hojas 'liveReminders/<liveId>/<campo>' (formato
+// que escribe drex-cloud.js: Ref.set() desglosa los objetos en hojas).
+async function listReminderTickets() {
+  const byId = new Map();
+  let lastKey;
+  do {
+    const res = await ddb.send(new QueryCommand({
+      TableName: TABLE,
+      KeyConditionExpression: 'pk = :pk',
+      ExpressionAttributeValues: { ':pk': 'liveReminders' },
+      ...(lastKey ? { ExclusiveStartKey: lastKey } : {}),
+    }));
+    for (const item of res.Items || []) {
+      try {
+        const sk = String(item.sk || '');
+        const slash = sk.indexOf('/');
+        if (slash < 0) continue;
+        const id = sk.slice(0, slash), field = sk.slice(slash + 1);
+        let t = byId.get(id);
+        if (!t) { t = { id }; byId.set(id, t); }
+        const v = parseLeaf(item.v);
+        if (v !== undefined) t[field] = v;
+      } catch (_) {}
+    }
+    lastKey = res.LastEvaluatedKey;
+  } while (lastKey);
+  return [...byId.values()];
+}
+
+function schedTicketDue(t, now) {
+  if (!t || t.status !== 'pending') return false;
+  const ra = Number(t.remindAt), at = Number(t.scheduledAt);
+  if (!ra || !isFinite(ra) || ra > now) return false;
+  if (!at || !isFinite(at)) return false;
+  if ((now - at) > SCHED_EXPIRE_MS) return false; // live ya pasado: no disparar
+  return true;
+}
+
+// Claim atómico sobre la hoja de estado: solo un invocador envía
+// (seguro ante el verificador del cliente corriendo a la vez).
+async function claimReminderTicket(liveId) {
+  try {
+    await ddb.send(new UpdateCommand({
+      TableName: TABLE,
+      Key: { pk: 'liveReminders', sk: liveId + '/status' },
+      UpdateExpression: 'SET v = :sending',
+      ConditionExpression: 'v = :pending',
+      ExpressionAttributeValues: {
+        ':sending': JSON.stringify('sending'),
+        ':pending': JSON.stringify('pending'),
+      },
+    }));
+    return true;
+  } catch (err) {
+    if (err && err.name === 'ConditionalCheckFailedException') return false;
+    throw err;
+  }
+}
+
+async function setTicketLeaf(liveId, field, value) {
+  await ddb.send(new PutCommand({
+    TableName: TABLE,
+    Item: { pk: 'liveReminders', sk: liveId + '/' + field, v: JSON.stringify(value) },
+  }));
+}
+
+async function deleteTicketLeaves(liveId) {
+  const prefix = liveId + '/';
+  const keys = [{ pk: 'liveReminders', sk: liveId }];
+  let lastKey;
+  do {
+    const res = await ddb.send(new QueryCommand({
+      TableName: TABLE,
+      KeyConditionExpression: 'pk = :pk AND begins_with(sk, :sk)',
+      ExpressionAttributeValues: { ':pk': 'liveReminders', ':sk': prefix },
+      ProjectionExpression: 'pk, sk',
+      ...(lastKey ? { ExclusiveStartKey: lastKey } : {}),
+    }));
+    for (const item of res.Items || []) keys.push({ pk: 'liveReminders', sk: item.sk });
+    lastKey = res.LastEvaluatedKey;
+  } while (lastKey);
+  for (let i = 0; i < keys.length; i += 25) {
+    const batch = keys.slice(i, i + 25).map(k => ({ DeleteRequest: { Key: k } }));
+    await ddb.send(new BatchWriteCommand({ RequestItems: { [TABLE]: batch } }));
+  }
+}
+
+// {lang, fiestasOff} del destinatario desde las hojas userSettings/<uid>/*.
+async function getUserBlurb(uid) {
+  let lang = 'en', fiestasOff = false;
+  try {
+    let lastKey;
+    do {
+      const res = await ddb.send(new QueryCommand({
+        TableName: TABLE,
+        KeyConditionExpression: 'pk = :pk AND begins_with(sk, :sk)',
+        ExpressionAttributeValues: { ':pk': 'userSettings', ':sk': uid + '/' },
+        ProjectionExpression: 'sk, v',
+        ...(lastKey ? { ExclusiveStartKey: lastKey } : {}),
+      }));
+      for (const item of res.Items || []) {
+        const sk = String(item.sk || '');
+        const rel = sk.slice(uid.length + 1);
+        const v = parseLeaf(item.v);
+        if (rel === 'appLanguage' && typeof v === 'string') {
+          if (v === 'es' || v === 'en' || v === 'zh' || v === 'pt') lang = v;
+        } else if (rel === 'notifications/fiestas' && v === false) {
+          fiestasOff = true;
+        }
+      }
+      lastKey = res.LastEvaluatedKey;
+    } while (lastKey);
+  } catch (_) {}
+  return { lang, fiestasOff };
+}
+
+async function listFollowers(hostUid) {
+  const out = [];
+  const prefix = hostUid + '/';
+  let lastKey;
+  do {
+    const res = await ddb.send(new QueryCommand({
+      TableName: TABLE,
+      KeyConditionExpression: 'pk = :pk AND begins_with(sk, :sk)',
+      ExpressionAttributeValues: { ':pk': 'followers', ':sk': prefix },
+      ProjectionExpression: 'sk',
+      ...(lastKey ? { ExclusiveStartKey: lastKey } : {}),
+    }));
+    for (const item of res.Items || []) {
+      const sk = String(item.sk || '');
+      if (!sk.startsWith(prefix)) continue;
+      const fid = sk.slice(prefix.length).split('/')[0];
+      if (fid && fid !== hostUid && !out.includes(fid)) out.push(fid);
+    }
+    lastKey = res.LastEvaluatedKey;
+  } while (lastKey);
+  return out;
+}
+
+function newSchedNotifId() {
+  return 'sched-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
+}
+
+export const schedulerHandler = async (event) => {
+  ensureVapid();
+  const now = Date.now();
+  let scanned = 0, fired = 0, skipped = 0;
+  let tickets = [];
+  try {
+    tickets = await listReminderTickets();
+  } catch (e) {
+    console.log('sched-list-error', String((e && e.message) || e));
+  }
+  for (const t of tickets) {
+    scanned++;
+    try {
+      if (!schedTicketDue(t, now)) continue;
+      const liveId = String(t.id || '');
+      if (!liveId) continue;
+      // El programado debe seguir vigente; si no, limpiar el ticket.
+      let schedStatus = null;
+      try {
+        const sres = await ddb.send(new GetCommand({
+          TableName: TABLE,
+          Key: { pk: 'scheduledLives', sk: liveId + '/status' },
+        }));
+        schedStatus = sres && sres.Item ? parseLeaf(sres.Item.v) : null;
+      } catch (_) {}
+      if (schedStatus !== 'scheduled') {
+        await deleteTicketLeaves(liveId).catch(() => {});
+        continue;
+      }
+      const claimed = await claimReminderTicket(liveId).catch(() => false);
+      if (!claimed) { skipped++; continue; } // otro invocador (o el cliente) lo tomó
+      const hostUid = String(t.hostUid || '');
+      const hostName = String(t.hostName || 'Drex');
+      const title = String(t.title || '');
+      const followers = hostUid ? await listFollowers(hostUid) : [];
+      let sent = 0;
+      for (const fid of followers) {
+        try {
+          const { lang, fiestasOff } = await getUserBlurb(fid);
+          if (fiestasOff) continue; // opt-out 'fiestas' respetado
+          const nid = newSchedNotifId();
+          const notif = {
+            message: schedMsg(hostName, title, lang),
+            timestamp: now,
+            read: false,
+            type: 'live',
+            notificationId: nid,
+            actionType: 'live',
+            actionId: liveId,
+            schedId: liveId,
+            scheduledAt: Number(t.scheduledAt) || now,
+            actorId: hostUid,
+            reminder: true,
+          };
+          // Ítem de objeto entero: es el formato que consume el handler del
+          // stream (JSON.parse(img.v.S) -> n.message).
+          await ddb.send(new PutCommand({
+            TableName: TABLE,
+            Item: { pk: 'notifications', sk: fid + '/' + nid, v: JSON.stringify(notif) },
+          }));
+          sent++;
+        } catch (_) {}
+      }
+      await setTicketLeaf(liveId, 'status', 'sent').catch(() => {});
+      await setTicketLeaf(liveId, 'sentAt', now).catch(() => {});
+      fired++;
+      console.log('sched-fired', JSON.stringify({ liveId, sent }));
+    } catch (_) {
+      skipped++;
+    }
+  }
+  console.log('sched-result', JSON.stringify({ scanned, fired, skipped }));
+  return { scanned, fired, skipped };
+};
